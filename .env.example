# --- App ---
APP_SECRET_KEY=change-me-to-a-long-random-string
AUTH_BACKEND=basic

# Encryption key for storing OAuth tokens etc. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=change-me-fernet-key

# Bootstrap admin user (created on startup if no users exist yet)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

# --- Database ---
# docker-compose maps the db container's 5432 to host port 5434 (5432/5433
# are often already taken by other local Postgres instances). Inside
# docker-compose, the app container overrides this to db:5432 automatically -
# this value is for running the app locally (outside docker) against the
# compose db.
DATABASE_URL=postgresql+psycopg://socialize:socialize@localhost:5434/socialize

# --- Redis ---
# Not read by anything yet - added ahead of migrating login-attempt
# throttling/rate limiting off in-process memory, needed once this runs as
# more than one app replica. docker-compose overrides this to redis:6379
# automatically; host port is mapped to 6381 (see DATABASE_URL above for
# why - avoids colliding with a local Redis install).
REDIS_URL=redis://localhost:6381/0

# --- LLM providers ---
# Optional now - each user can set their own keys on /account instead (used
# for brands they own). These only act as the fallback when a brand's owner
# hasn't configured their own key for a provider - handy for a first boot
# before anyone's visited /account yet, or a single-user setup that doesn't
# want per-user key management at all.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# For Vertex AI (Veo / Imagen), used from Phase 2+:
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=

# --- Storage ---
# STORAGE_BACKEND=local_disk | r2
STORAGE_BACKEND=local_disk
LOCAL_STORAGE_DIR=./data/media

# Cloudflare R2 - only needed if STORAGE_BACKEND=r2. Create an API token
# scoped to R2 (dashboard -> R2 -> Manage API Tokens) for the access
# key/secret; the account id is shown on the R2 overview page. The bucket
# stays private - media is served via short-lived presigned URLs, not a
# public bucket URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PRESIGNED_URL_EXPIRY_SECONDS=3600

# --- Gmail (Phase 1) ---
# One shared OAuth client for the whole app (each brand still gets its own
# token). For a real domain use a "Web application" client with
# https://<your-domain>/brand-kit/gmail/callback as an authorized redirect
# URI and set these two - they take precedence over the file below.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Otherwise: downloaded OAuth client JSON from Google Cloud Console
# (a "Desktop app" client works for local dev on localhost).
GMAIL_CREDENTIALS_PATH=./secrets/gmail_credentials.json

# --- GitHub (second content source, alongside Gmail) ---
# Optional shared fallback PAT ("repo" scope for private repos) - each
# brand can set its own on the Brand Kit page instead, same pattern as
# Postiz/Botsab.
GITHUB_TOKEN=

# --- Postiz ---
# POSTIZ_BASE_URL is the one shared Postiz deployment endpoint. API_KEY is
# optional - each brand can set its own on the Brand Kit page instead (its
# own channels); this is only the fallback for a brand that hasn't
# configured its own.
POSTIZ_BASE_URL=https://social.shackyapps.in
POSTIZ_API_KEY=

# --- Botsab (WhatsApp) ---
# BOTSAB_BASE_URL is the one shared Botsab deployment endpoint. API_KEY/
# INSTANCE_ID are optional now - each brand can set its own on the Brand Kit
# page instead (a different WhatsApp number per brand); these are only the
# fallback for a brand that hasn't configured its own.
BOTSAB_BASE_URL=https://botsab.shackyapps.in
BOTSAB_API_KEY=
BOTSAB_INSTANCE_ID=

# --- Resend (email verification) ---
# Optional - self-serve signup (/signup) works without these, it just
# auto-verifies every new account instead of emailing a confirmation link.
# Set both to require real email verification before a new signup can log
# in. Get an API key at https://resend.com/api-keys (needs an account).
# RESEND_FROM_EMAIL must be an address on a domain verified in the Resend
# dashboard (Domains -> Add Domain, then add the DNS records it gives you) -
# for quick testing without your own domain, RESEND_FROM_EMAIL can be
# onboarding@resend.dev, but that address only delivers to the email you
# signed up to Resend with, not real users.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Socialize <noreply@yourdomain.com>
